{
  "name": "dsh-pin-workspaces",
  "version": "0.2.2",
  "description": "把工作区置顶到侧栏最前：右键置顶／取消置顶，置顶行用强调色显示，设置里可查看并取消。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "pin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
